# Goes into a connection URL, so hex only. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=changeme

# Browser origins allowed to open a socket, comma-separated, scheme included.
ALLOWED_ORIGINS=https://spaceguesser.example

# Host directory for the Postgres data volume.
PG_DATA_HOST_DIR=/srv/spaceguesser/pg_data

# Cloudflare tunnel token.
# The tunnel's public hostname must route to http://multiplayer:8787.
TUNNEL_TOKEN=changeme
