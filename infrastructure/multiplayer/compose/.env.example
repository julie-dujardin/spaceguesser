# Goes into a connection URL, so hex only. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=changeme

# Browser origins allowed to open a socket, comma-separated, scheme included.
ALLOWED_ORIGINS=https://spaceguesser.example

# Secret key of the Turnstile widget whose sitekey the site is set to.
# The server does not start on one Cloudflare does not know. Left out, with
# TURNSTILE_REQUIRE, it asks nobody for proof.
TURNSTILE_SECRET=changeme

# What takes proof of a person, comma-separated: create, join. Empty checks and
# logs the proofs that come and refuses nobody, which is where to leave it
# until the site is live with the sitekey: a page without has none to give.
TURNSTILE_REQUIRE=create

# Host address the server's counts are published on, port 9787. Empty is
# loopback, which `tailscale serve` passes on to the tailnet. Never 0.0.0.0.
METRICS_HOST=

# Host directory for the Postgres data volume.
PG_DATA_HOST_DIR=/srv/spaceguesser/pg_data

# Cloudflare tunnel token.
# The tunnel's public hostname must route to http://multiplayer:8787.
TUNNEL_TOKEN=changeme
