{
	"name": "spaceguesser",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "pnpm check && vite build",
		"preview": "vite preview",
		"format": "prettier --write .",
		"messages": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy preferredLanguage baseLocale --emit-ts-declarations --silent",
		"check": "pnpm messages && tsc -b",
		"test": "vitest run",
		"deploy": "pnpm build && wrangler deploy --config ../infrastructure/deploy/wrangler.jsonc"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"spacemap": "^0.1.11",
		"three": "^0.183.2",
		"uqr": "^0.1.3"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.26.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/three": "^0.183.1",
		"@vitejs/plugin-react": "^5.1.0",
		"prettier": "^3.9.6",
		"typescript": "^5.9.3",
		"vite": "^7.2.0",
		"vitest": "^5.0.3",
		"wrangler": "^4.131.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	},
	"packageManager": "pnpm@10.31.0"
}
